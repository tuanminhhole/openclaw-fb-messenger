{
  "name": "openclaw-fb-messenger",
  "version": "0.3.0",
  "private": true,
  "description": "Facebook Messenger + Instagram channel plugin for OpenClaw: relay via MonkeyTech Connect (no token on the bot) or direct webhook + Graph API; AI handled by the OpenClaw agent.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "tuanminhole",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuanminhhole/openclaw-fb-messenger.git"
  },
  "homepage": "https://github.com/tuanminhhole/openclaw-fb-messenger#readme",
  "bugs": {
    "url": "https://github.com/tuanminhhole/openclaw-fb-messenger/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "channel",
    "facebook",
    "messenger",
    "fb-messenger",
    "chatbot",
    "cskh"
  ],
  "files": [
    "dist",
    "openclaw.plugin.json",
    "logo.svg",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --check dist/index.js",
    "test": "tsup docs_dev/tests/smoke.ts --format esm --external openclaw -d docs_dev/tests/dist && node docs_dev/tests/dist/smoke.js",
    "release": "node docs_dev/scripts/update.mjs",
    "prepublishOnly": "npm run build",
    "test:e2e": "tsup docs_dev/tests/e2e-connect.ts --format esm --external openclaw -d docs_dev/tests/dist && node docs_dev/tests/dist/e2e-connect.js"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "fb-messenger",
      "label": "Facebook Messenger",
      "selectionLabel": "Facebook (Messenger)",
      "docsPath": "/channels/fb-messenger",
      "docsLabel": "fb-messenger",
      "blurb": "Facebook Page Messenger + Instagram via MonkeyTech Connect relay or direct webhook.",
      "aliases": [
        "fb",
        "messenger"
      ],
      "order": 90,
      "quickstartAllowFrom": false
    },
    "install": {
      "clawhubSpec": "tuanminhhole/openclaw-fb-messenger",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.10"
    },
    "compat": {
      "pluginApi": ">=2026.6.10",
      "minGatewayVersion": "2026.6.10"
    },
    "build": {
      "entry": "./dist/index.js",
      "openclawVersion": "2026.6.10",
      "pluginSdkVersion": "2026.6.10"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.10"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^22.0.0",
    "openclaw": ">=2026.6.10",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
