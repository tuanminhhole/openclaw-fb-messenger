{
  "id": "fb-messenger",
  "name": "Facebook Messenger",
  "description": "OpenClaw Facebook Messenger + Instagram channel plugin: relay via MonkeyTech Connect (no token on the bot) or direct webhook + Graph API.",
  "icon": "https://cdn.jsdelivr.net/gh/tuanminhhole/openclaw-fb-messenger@main/logo.svg",
  "version": "0.2.1",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "fb-messenger"
  ],
  "channelEnvVars": {
    "fb-messenger": [
      "FB_MESSENGER_PAGE_ACCESS_TOKEN",
      "FB_MESSENGER_APP_ID",
      "FB_MESSENGER_APP_SECRET",
      "FB_MESSENGER_VERIFY_TOKEN",
      "FB_MESSENGER_RELAY_KEY"
    ]
  },
  "setup": {
    "providers": [
      {
        "id": "fb-messenger",
        "channel": "fb-messenger",
        "envVars": [
          "FB_MESSENGER_PAGE_ACCESS_TOKEN",
          "FB_MESSENGER_APP_ID",
          "FB_MESSENGER_APP_SECRET",
          "FB_MESSENGER_VERIFY_TOKEN",
          "FB_MESSENGER_RELAY_KEY"
        ]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "fb-messenger": {
      "label": "Facebook Messenger",
      "description": "Facebook Page Messenger via webhook + Graph API.",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "pageId": {
            "type": "string",
            "description": "Facebook Page ID this account answers for."
          },
          "pageAccessToken": {
            "type": "string",
            "description": "Page Access Token, or any User token (the plugin auto-exchanges it for a permanent Page token). Prefer env FB_MESSENGER_PAGE_ACCESS_TOKEN."
          },
          "appId": {
            "type": "string",
            "description": "Meta App ID. Needed to exchange a short-lived token into a never-expiring Page token. Prefer env FB_MESSENGER_APP_ID."
          },
          "appSecret": {
            "type": "string",
            "description": "Meta App Secret for X-Hub-Signature-256 verification. Prefer env FB_MESSENGER_APP_SECRET."
          },
          "verifyToken": {
            "type": "string",
            "description": "Webhook verify token (you choose this). Prefer env FB_MESSENGER_VERIFY_TOKEN."
          },
          "graphApiVersion": {
            "type": "string",
            "description": "Graph API version. Defaults to v24.0."
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "pairing",
              "allowlist",
              "open",
              "disabled"
            ],
            "default": "open"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "historyLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "markdown": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tables": {
                "type": "string",
                "enum": [
                  "off",
                  "bullets",
                  "code",
                  "block"
                ]
              }
            }
          },
          "messagePrefix": {
            "type": "string"
          },
          "responsePrefix": {
            "type": "string"
          },
          "defaultAccount": {
            "type": "string"
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "pageId": {
                  "type": "string"
                },
                "pageAccessToken": {
                  "type": "string"
                },
                "appId": {
                  "type": "string"
                },
                "appSecret": {
                  "type": "string"
                },
                "verifyToken": {
                  "type": "string"
                },
                "graphApiVersion": {
                  "type": "string"
                },
                "dmPolicy": {
                  "type": "string",
                  "enum": [
                    "pairing",
                    "allowlist",
                    "open",
                    "disabled"
                  ]
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "historyLimit": {
                  "type": "integer",
                  "minimum": 0
                },
                "messagePrefix": {
                  "type": "string"
                },
                "responsePrefix": {
                  "type": "string"
                },
                "transport": {
                  "type": "string",
                  "enum": [
                    "webhook",
                    "relay"
                  ],
                  "description": "relay: long-poll MonkeyTech Connect, bot holds no Page token (default when no pageAccessToken). webhook: Meta calls this gateway directly (needs public HTTPS + App Secret)."
                },
                "relayUrl": {
                  "type": "string",
                  "description": "Connect base URL. Defaults to https://connect.monkeytech.vn."
                },
                "instagramId": {
                  "type": "string",
                  "description": "Instagram professional account linked to the Page (informational; Connect routes Instagram events by Page)."
                },
                "ackReaction": {
                  "type": "string",
                  "description": "Reaction sent on every inbound message as a receipt: an emoji, or the Zalo code \"/-heart\" (mapped to the heart emoji). Instagram always uses \"love\". Defaults to messages.ackReaction; set \"\" to disable."
                }
              }
            }
          },
          "transport": {
            "type": "string",
            "enum": [
              "webhook",
              "relay"
            ],
            "description": "relay: long-poll MonkeyTech Connect, bot holds no Page token (default when no pageAccessToken). webhook: Meta calls this gateway directly (needs public HTTPS + App Secret)."
          },
          "relayUrl": {
            "type": "string",
            "description": "Connect base URL. Defaults to https://connect.monkeytech.vn."
          },
          "instagramId": {
            "type": "string",
            "description": "Instagram professional account linked to the Page (informational; Connect routes Instagram events by Page)."
          },
          "ackReaction": {
            "type": "string",
            "description": "Reaction sent on every inbound message as a receipt: an emoji, or the Zalo code \"/-heart\" (mapped to the heart emoji). Instagram always uses \"love\". Defaults to messages.ackReaction; set \"\" to disable."
          }
        }
      }
    }
  }
}
