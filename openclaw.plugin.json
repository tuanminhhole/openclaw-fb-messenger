{
  "id": "fb-messenger",
  "name": "Facebook Messenger",
  "description": "OpenClaw Facebook Messenger channel plugin via webhook + Graph API.",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "fb-messenger"
  ],
  "channelEnvVars": {
    "fb-messenger": [
      "FB_MESSENGER_PAGE_ACCESS_TOKEN",
      "FB_MESSENGER_APP_SECRET",
      "FB_MESSENGER_VERIFY_TOKEN"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "fb-messenger": {
      "label": "Facebook Messenger",
      "description": "Facebook Page Messenger via webhook + Graph API.",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "pageId": {
            "type": "string",
            "description": "Facebook Page ID this account answers for."
          },
          "pageAccessToken": {
            "type": "string",
            "description": "Page Access Token. Prefer env FB_MESSENGER_PAGE_ACCESS_TOKEN."
          },
          "appSecret": {
            "type": "string",
            "description": "Meta App Secret for X-Hub-Signature-256 verification. Prefer env FB_MESSENGER_APP_SECRET."
          },
          "verifyToken": {
            "type": "string",
            "description": "Webhook verify token (you choose this). Prefer env FB_MESSENGER_VERIFY_TOKEN."
          },
          "graphApiVersion": {
            "type": "string",
            "description": "Graph API version. Defaults to v21.0."
          },
          "dmPolicy": {
            "type": "string",
            "enum": ["pairing", "allowlist", "open", "disabled"],
            "default": "open"
          },
          "allowFrom": {
            "type": "array",
            "items": { "type": "string" }
          },
          "historyLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "markdown": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tables": {
                "type": "string",
                "enum": ["off", "bullets", "code", "block"]
              }
            }
          },
          "messagePrefix": { "type": "string" },
          "responsePrefix": { "type": "string" },
          "defaultAccount": { "type": "string" },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "enabled": { "type": "boolean" },
                "pageId": { "type": "string" },
                "pageAccessToken": { "type": "string" },
                "appSecret": { "type": "string" },
                "verifyToken": { "type": "string" },
                "graphApiVersion": { "type": "string" },
                "dmPolicy": {
                  "type": "string",
                  "enum": ["pairing", "allowlist", "open", "disabled"]
                },
                "allowFrom": { "type": "array", "items": { "type": "string" } },
                "historyLimit": { "type": "integer", "minimum": 0 },
                "messagePrefix": { "type": "string" },
                "responsePrefix": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
